<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Abstractions only. A message that could not be delivered is swallowed on
         purpose, per FR-005, so it has to be recorded somewhere or nobody would
         ever learn that mail is down. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoxLib.Model\VoxLib.Model.csproj" />
  </ItemGroup>

</Project>
