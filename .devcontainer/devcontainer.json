// vox-lib: ASP.NET Core Web API (.NET 10) + React/Vite frontend
// Format reference: https://aka.ms/devcontainer.json
{
  "name": "vox-lib (.NET 10 + React)",

  // Compose rather than a bare Dockerfile, because the catalogue needs a real
  // PostgreSQL alongside the application. The service names and the volume list
  // live in docker-compose.yml; workspaceFolder must match the bind mount
  // declared there.
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/vox-lib",
  "shutdownAction": "stopCompose",

  "features": {
    // Node 24 "Krypton" is the current Active LTS. pnpm is installed by the
    // feature itself so it exists before postCreateCommand runs.
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "pnpmVersion": "latest",
      "installYarnUsingApt": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Named volumes survive a container REBUILD; /home/vscode is on overlayfs and
  // does not. Anything you would be sad to lose must be a volume. They moved
  // into docker-compose.yml when this became a Compose dev container, which is
  // also where the reasoning for each one now lives.
  //
  // NOTE: the pnpm store is deliberately NOT a volume. pnpm hardlinks from its
  // store into node_modules, and hardlinks cannot cross filesystems, so the
  // store must live on the same filesystem as node_modules. It is set to
  // <repo>/.pnpm-store in post-create.sh, inside the workspace bind mount.

  "remoteEnv": {
    "HISTFILE": "/commandhistory/.bash_history",
    // Claude Code keeps per-project state (trust, onboarding, MCP servers) in
    // ~/.claude.json, a sibling of ~/.claude rather than a file inside it, so
    // the volume above does not cover it. Pointing the config dir at the volume
    // puts both on persistent storage.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "PNPM_HOME": "/home/vscode/.local/share/pnpm",
    "PATH": "/home/vscode/.local/share/pnpm:${containerEnv:PATH}",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    // inotify works on this ext4 workspace volume; polling only adds latency.
    "DOTNET_USE_POLLING_FILE_WATCHER": "false",
    "ASPNETCORE_ENVIRONMENT": "Development"
  },

  "forwardPorts": [5080, 5443, 5173],
  "portsAttributes": {
    "5080": { "label": "API (http)", "onAutoForward": "silent" },
    "5443": { "label": "API (https)", "protocol": "https", "onAutoForward": "silent" },
    "5173": { "label": "Web (vite)", "onAutoForward": "notify" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "oxc.oxc-vscode",
        "esbenp.prettier-vscode",
        "editorconfig.editorconfig",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "humao.rest-client"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "[csharp]": { "editor.defaultFormatter": "ms-dotnettools.csharp" },
        "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "dotnet.defaultSolution": "backend/VoxLib.slnx",
        "files.exclude": {
          "**/bin": true,
          "**/obj": true
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/bin": true,
          "**/obj": true,
          "**/pnpm-lock.yaml": true
        },
        "npm.packageManager": "pnpm",
        "typescript.tsdk": "frontend/node_modules/typescript/lib",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteUser": "vscode"
}
