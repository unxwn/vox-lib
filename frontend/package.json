{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && tsc -b && react-router build",
    "lint": "oxlint && node scripts/check-design-tokens.mjs",
    "preview": "vite preview",
    "test:a11y": "playwright test",
    "gen:api-types": "openapi-typescript http://localhost:5080/openapi/v1.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "isbot": "^5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.3.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "openapi-typescript": "^6.7.6",
    "oxlint": "^1.79.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
